<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Domestic Help"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service Details"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cleaning"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#536DFE"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLocality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Rajpur Road"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp" />

        <!-- Dynamic Form -->

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Additional Details -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Additional Details"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etAdditionalDetails"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Tell us anything else about your requirement..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp" />

        <!-- Continue -->

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Continue to Price Estimate"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#536DFE"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>