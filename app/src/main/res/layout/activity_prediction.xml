<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <!-- App Name -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Domestic Help"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <!-- Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimated Service Price"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginTop="30dp" />

        <!-- Service Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected Service"
                android:textSize="14sp"
                android:textColor="#777777"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cleaning"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#536DFE"
                android:gravity="center"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/tvLocality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Rajpur Road"
                android:textSize="15sp"
                android:textColor="#666666"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Details -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Requirement"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your selected requirements will appear here."
            android:textSize="16sp"
            android:textColor="#555555"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp" />

        <!-- Price -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="25dp"
            android:background="#E8F5E9"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimated Price"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Price will be estimated by ML"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00897B"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Workers -->

        <Button
            android:id="@+id/btnViewWorkers"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View Available Workers"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#536DFE"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>