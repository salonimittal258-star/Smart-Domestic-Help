<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="25dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Domestic Help"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:gravity="center"
            android:layout_marginTop="35dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="60sp"
            android:textStyle="bold"
            android:textColor="#00897B"
            android:gravity="center"
            android:layout_marginTop="35dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Confirmed!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00897B"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your service has been successfully booked."
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />

        <TextView
            android:id="@+id/tvWorker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Worker:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Service:"
            android:textSize="17sp"
            android:textColor="#444444"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvLocality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Location:"
            android:textSize="17sp"
            android:textColor="#444444"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Date:"
            android:textSize="17sp"
            android:textColor="#444444"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=" Time:"
            android:textSize="17sp"
            android:textColor="#444444"
            android:padding="12dp"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Back to Home"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#536DFE" />

    </LinearLayout>

</ScrollView>

