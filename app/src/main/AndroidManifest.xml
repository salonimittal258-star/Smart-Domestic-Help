<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Smart Domestic Help"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".PredictionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BookingActivity" />
        <activity android:name=".WorkerListActivity" />
        <activity android:name=".LocalityActivity" />
        <activity android:name=".UserHomeActivity" />
        <activity android:name=".UserSignupActivity" />
        <activity android:name=".UserLoginActivity" />
        <activity android:name=".WorkerSignupActivity" />
        <activity android:name=".WorkerLoginActivity" />
        <activity android:name=".ServiceDetailsActivity" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BookingConfirmationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>